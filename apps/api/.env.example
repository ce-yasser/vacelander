# PostgreSQL connection string (matches docker-compose.yml).
# Defaults to this value when unset.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vaclendar"

# Origin(s) allowed to call this API from a browser (comma-separated).
# Defaults to http://localhost:3000 when unset.
CORS_ORIGIN="http://localhost:3000"

# Max connections per server instance (each serverless instance has its own pool).
# Defaults to 5 when unset.
DATABASE_POOL_MAX="5"
